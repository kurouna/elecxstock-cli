{
  "name": "elecxstock-cli",
  "version": "0.1.0",
  "description": "elecxstock のデータをターミナルで top のように眺める読み取り専用の CUI",
  "license": "MIT",
  "type": "module",
  "private": true,
  "elecxstock": {
    "version": "0.1.3"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "build": "node scripts/build.mjs",
    "sea": "node scripts/build.mjs && node scripts/sea.mjs",
    "fixture": "tsx scripts/fixture.ts",
    "shots": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shots.ps1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3",
    "ink": "^6.8.0",
    "react": "^19.2.0",
    "string-width": "^8.3.0",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
